{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdnotes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdnotes",
      // PLACEHOLDER — replace with the real id printed by `wrangler d1 create mdnotes`
      // before the first remote deploy. Local dev/tests ignore this value.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      // PLACEHOLDER — must match the bucket created with
      // `wrangler r2 bucket create mdnotes-assets`.
      "bucket_name": "mdnotes-assets"
    }
  ],

  "vars": {
    "PBKDF2_ITERATIONS": "100000"
  }
}
